---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** La app interna no se indexa. */
  noindex?: boolean;
}
const { title, description = 'Protectora Modepran', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#bb4a20" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Tema: 'light' | 'dark' | (sin valor = sistema). Antes de pintar para evitar parpadeo.
      (function () {
        var t = null;
        try { t = localStorage.getItem('modepran-theme'); } catch (e) {}
        var dark = t === 'dark' || (t !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
